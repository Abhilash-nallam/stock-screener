# Local-only Telegram long-polling configuration.
# Production webhook secrets belong in Cloudflare Worker secrets and GitHub Actions secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
LOG_LEVEL=INFO

# Optional password for manual scans in a private Streamlit dashboard.
# Leave unset to keep public dashboard scan controls disabled.
RADAR_DASHBOARD_PASSWORD=
